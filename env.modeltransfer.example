#!/usr/bin/env bash

# Hugging Face
# For public models, HF_TOKEN can be left empty.
export HF_TOKEN=""

# Hugging Face repo/file
export HF_REPO_ID="unsloth/Qwen3.5-9B-GGUF"
# Leave as "" to download the full repo.
export HF_FILENAME="Qwen3.5-9B-UD-Q4_K_XL.gguf"

# Cloudflare R2
# Using the repo ID as prefix preserves the Hugging Face path in R2.
export R2_PREFIX="$HF_REPO_ID"
export R2_BUCKET="your-r2-bucket-name"

# R2 S3-compatible credentials
export AWS_ACCESS_KEY_ID="your-r2-access-key-id"
export AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
export AWS_DEFAULT_REGION="auto"

# Cloudflare account ID, not bucket ID.
export CF_ACCOUNT_ID="your-cloudflare-account-id"
export R2_ENDPOINT="https://$CF_ACCOUNT_ID.r2.cloudflarestorage.com"

# Faster Hugging Face downloads
export HF_HUB_ENABLE_HF_TRANSFER=1

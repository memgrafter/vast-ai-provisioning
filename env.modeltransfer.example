# Local-only model transfer credentials/private destination.
# Model identity and R2 prefix come from --model-profile, not this file.
# Copy to env.modeltransfer and fill locally. Do not commit real values.

# Optional: only needed for private/gated Hugging Face repos.
export HF_TOKEN=""

# Cloudflare R2 destination for model mirroring.
export R2_BUCKET="your-r2-bucket-name"
export R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
export AWS_ACCESS_KEY_ID="your-r2-access-key-id"
export AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
export AWS_DEFAULT_REGION="auto"

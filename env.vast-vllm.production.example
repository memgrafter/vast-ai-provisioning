# Vast.ai vLLM production template env
# Launch mode: Docker ENTRYPOINT
# Image: official/cached vastai/vllm tag from Vast template UI

# R2 artifact source. Keep R2_PREFIX equal to HF repo ID for easy model swaps.
R2_BUCKET="your-r2-bucket-name"
R2_PREFIX="cyankiwi/Qwen3.5-9B-AWQ-4bit"
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="your-r2-access-key-id"
AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
AWS_DEFAULT_REGION="auto"

# Local model path on the Vast machine.
MODEL_DIR="/workspace/models/cyankiwi/Qwen3.5-9B-AWQ-4bit"

# vLLM image settings. The image runs: vllm serve "$VLLM_MODEL" $VLLM_ARGS
VLLM_MODEL="/workspace/models/cyankiwi/Qwen3.5-9B-AWQ-4bit"
VLLM_ARGS="--served-model-name qwen3.5-9b-awq --quantization awq --dtype half --host 127.0.0.1 --port 18000 --download-dir /workspace/models --gpu-memory-utilization 0.90 --trust-remote-code"

# For this 9B AWQ model, prefer single-GPU unless intentionally renting multi-GPU.
AUTO_PARALLEL="false"

# Host provision_vast_vllm_from_r2.sh at a raw HTTPS URL and paste it here.
PROVISIONING_SCRIPT="https://raw.githubusercontent.com/<you>/<repo>/<branch>/provision_vast_vllm_from_r2.sh"

# Optional; enable if you want HTTPS on proxied services.
# ENABLE_HTTPS="true"

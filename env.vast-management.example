# Local-only Vast management/API testing env.
# Copy to env.vast-management and fill locally. Do not commit real values.

# Used by Vast SDK scripts that search offers, launch/destroy instances, and apply templates.
export VAST_API_KEY=""

# Optional local convenience for curl smoke tests against vLLM.
# The actual runtime value must be configured as a Vast account-level env var.
export VLLM_API_KEY=""
